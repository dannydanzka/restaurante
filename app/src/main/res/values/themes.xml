<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema principal de la app -->
    <style name="Theme.Restaurante" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- 🔹 Corregir la visibilidad de la barra de estado -->
        <item name="android:statusBarColor">@color/purple_700</item>  <!-- Fondo morado oscuro -->
        <item name="android:windowLightStatusBar">false</item>  <!-- Íconos blancos (hora, batería, señal) -->
    </style>
</resources>
